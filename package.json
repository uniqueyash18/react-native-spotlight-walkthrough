{
  "name": "react-native-spotlight-walkthrough",
  "version": "0.1.0",
  "description": "Interactive spotlight walkthroughs for React Native: pass-through targets, animated gesture simulations, audio/TTS narration, show-once persistence and a fully themeable UI.",
  "keywords": [
    "react-native",
    "walkthrough",
    "onboarding",
    "tour",
    "coachmark",
    "spotlight",
    "tooltip",
    "expo",
    "reanimated",
    "tts",
    "text-to-speech",
    "narration"
  ],
  "author": "Yash Chouhan (https://github.com/uniqueyash18)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniqueyash18/react-native-spotlight-walkthrough.git"
  },
  "bugs": {
    "url": "https://github.com/uniqueyash18/react-native-spotlight-walkthrough/issues"
  },
  "homepage": "https://github.com/uniqueyash18/react-native-spotlight-walkthrough#readme",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./expo-audio": {
      "types": "./lib/adapters/expo-audio.d.ts",
      "react-native": "./src/adapters/expo-audio.ts",
      "default": "./lib/adapters/expo-audio.js"
    },
    "./expo-speech": {
      "types": "./lib/adapters/expo-speech.d.ts",
      "react-native": "./src/adapters/expo-speech.ts",
      "default": "./lib/adapters/expo-speech.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "expo-audio": "*",
    "expo-speech": "*",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-reanimated": ">=3.6",
    "react-native-safe-area-context": ">=4",
    "react-native-svg": ">=13"
  },
  "peerDependenciesMeta": {
    "expo-audio": {
      "optional": true
    },
    "expo-speech": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "expo-audio": "~57.0.5",
    "expo-modules-core": "~57.0.21",
    "expo-speech": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
